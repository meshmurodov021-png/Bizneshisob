rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && pinFieldOk();

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction();
        allow update, delete: if isOwner(userId);
      }

      match /currencies/{currencyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCurrency();
        allow update: if isOwner(userId) && isValidCurrency();
        allow delete: if isOwner(userId);
      }
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // PIN must be PBKDF2 metadata only (never plaintext). Absent pin is allowed.
    function pinFieldOk() {
      return !('pin' in request.resource.data)
        || isValidPinMap(request.resource.data.pin);
    }

    function isValidPinMap(p) {
      return p is map
        && p.keys().hasAll(['algo', 'iterations', 'salt', 'hash', 'version', 'updatedAt'])
        && p.algo == 'PBKDF2-SHA256'
        && p.iterations is number
        && p.iterations >= 100000
        && p.salt is string
        && p.salt.size() >= 8
        && p.salt.size() <= 128
        && p.hash is string
        && p.hash.size() >= 16
        && p.hash.size() <= 128
        && p.version is number
        && p.version == 1
        && p.updatedAt is string
        && p.updatedAt.size() > 0
        && p.updatedAt.size() < 80;
    }

    function isValidTransaction() {
      return request.resource.data.keys().hasAll(['type', 'description', 'amount', 'date', 'userId', 'category'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.date is string
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && isValidCategory(request.resource.data.type, request.resource.data.category);
    }

    function isValidCategory(type, category) {
      return (type == 'income' && category in [
          'sotuv', 'xizmat', 'ish_haqi', 'investitsiya', 'boshqa_daromad'
        ])
        || (type == 'expense' && category in [
          'ijara', 'oziq_ovqat', 'transport', 'kommunal', 'telefon_internet',
          'ish_haqi_xodim', 'mahsulot', 'reklama', 'tamirlash', 'boshqa_xarajat'
        ]);
    }

    function isValidCurrency() {
      return request.resource.data.keys().hasAll(['name', 'symbol', 'rateToUZS', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.symbol is string
        && request.resource.data.symbol.size() > 0
        && request.resource.data.rateToUZS is number
        && request.resource.data.rateToUZS > 0
        && request.resource.data.createdAt is string;
    }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="120"
                android:endColor="#1E1038"
                android:centerColor="#142A1F"
                android:startColor="#3D2E10"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke
                android:width="2.5dp"
                android:color="#AA7C3AED" />
        </shape>
    </item>
</layer-list>

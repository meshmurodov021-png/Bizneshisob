<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:angle="145"
                android:centerColor="#0F172A"
                android:endColor="#0B1020"
                android:startColor="#142A1F"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke
                android:width="1.5dp"
                android:color="#5522C55E" />
        </shape>
    </item>
</layer-list>

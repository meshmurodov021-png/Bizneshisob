# PIN email OTP (Cloud Functions) — NOT used by the live client yet.
# Production PIN recovery uses Firebase Auth sendPasswordResetEmail (Spark).
# Re-enable requestPinEmailOtp / verifyPinEmailOtp in app.html only after:
#   1) Firebase Blaze plan is on, and
#   2) a mailer below is configured, then:
#      firebase deploy --only functions,firestore:rules
#
# Copy to .env.bizneshisob-886ab (gitignored) before `firebase deploy --only functions`
# OR set the same names as Cloud Run environment variables / Secret Manager secrets.
#
# Required for production email delivery — pick ONE:
#   1) Resend (recommended): https://resend.com
RESEND_API_KEY=
# Must be a verified domain/sender in Resend.
RESEND_FROM=BiznesHisob <noreply@your-verified-domain.com>

#   2) SMTP (Gmail app password, Mailgun, etc.)
# SMTP_URL=smtps://user:pass@smtp.example.com:465

#   3) Firebase "Trigger Email" extension — writes to Firestore `mail` collection
# PIN_OTP_USE_MAIL_COLLECTION=true

# Optional extra hash pepper (random 32+ chars). If unset, project id is used.
# PIN_OTP_PEPPER=

# DEV ONLY. Logs the plaintext OTP to Cloud Functions logs when no mailer is configured.
# Never enable on production. Emulator always uses this fallback automatically.
# PIN_OTP_DEV_FALLBACK=false

# --- Premium payments (Payme Merchant API + Click SHOP API) ---
# Set these in functions/.env.bizneshisob-886ab (gitignored) or as Cloud Run env vars.
# Do not commit real values. Checkout is refused with "payments-not-configured"
# until the provider's variables below are present.
#
# Payme Business cabinet:
#   Merchant API endpoint (test and production can share this URL):
#     https://us-central1-bizneshisob-886ab.cloudfunctions.net/paymeMerchant
#   Account field name: order_id
#   Amount is 29 900 so'm = 2 990 000 tiyin, fixed in code.
# PAYME_MERCHANT_ID=
# Production key. Webhook Basic auth is "Paycom:<this key>".
# PAYME_KEY=
# Sandbox key from the Payme test cabinet. Used only when PAYMENTS_TEST_MODE=true.
# PAYME_TEST_KEY=
# true -> checkout host https://test.paycom.uz and PAYME_TEST_KEY (else PAYME_KEY).
# PAYMENTS_TEST_MODE=false
# Optional override of the checkout host.
# PAYME_CHECKOUT_BASE=
#
# Click merchant cabinet (my.click.uz / merchant.click.uz):
#   Prepare URL and Complete URL (same endpoint; action=0 prepare, action=1 complete):
#     https://us-central1-bizneshisob-886ab.cloudfunctions.net/clickMerchant
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# Optional. Cabinet user id, sent as merchant_user_id when the payment page requires it.
# CLICK_MERCHANT_USER_ID=
# Optional override of the pay page. Default https://my.click.uz/services/pay
# CLICK_PAY_BASE=
#
# Where Payme/Click send the customer after payment. Default includes ?payment=return.
# PAYMENTS_RETURN_URL=https://bizneshisob.vercel.app/app?payment=return
